# Preview/debug native builds are intentionally locked to this reviewed HTTPS alias.
MOBILE_APP_ORIGIN=https://check-your-name-ai.vercel.app
MOBILE_RELEASE_BUILD=0

# A signed store build must set MOBILE_RELEASE_BUILD=1 and will remain blocked
# until REVIEWED_MOBILE_RELEASE_ORIGIN is committed in scripts/mobile-origin-policy.mjs
# through a separate security review. Never substitute a branch or mutable alias.

# Public client configuration only. Never place service_role, sb_secret_, private,
# signing, APNs, or FCM server credentials in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
