# Public client configuration only. Native releases bundle the SPA and do not
# accept a remote application origin. Never place service_role, sb_secret_,
# private, signing, APNs, or FCM server credentials in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
